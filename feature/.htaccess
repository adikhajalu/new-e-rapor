RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^daftar_rapor(?:\.smak)?$ rapor_list.php [L]
RewriteRule ^daftar_absensi(?:\.smak)?$ absensi_siswa_list.php [L]
RewriteRule ^satuan_absensi(?:\.smak)?$ add_absensi_siswa.php [L]
RewriteRule ^satuan_nilai_ekstrakrikuler(?:\.smak)?$ add_grade.php [L]
RewriteRule ^satuan_nilai_mapel(?:\.smak)?$ add_score.php [L]
RewriteRule ^satuan_siswa(?:\.smak)?$ add_student.php [L]
RewriteRule ^satuan_mata_pelajaran(?:\.smak)?$ add_subject.php [L]
RewriteRule ^ubah_password(?:\.smak)?$ change_password.php [L]
RewriteRule ^download_template_absensi(?:\.smak)?$ download_template_absensi_siswa.php [L]
RewriteRule ^download_template_nilai_ekstrakurikuler(?:\.smak)?$ download_template_grade.php [L]
RewriteRule ^download_template_nilai_mapel(?:\.smak)?$ download_template_score.php [L]
RewriteRule ^download_template_mapel(?:\.smak)?$ download_template_subject.php [L]
RewriteRule ^ubah_absensi(?:\.smak)?$ edit_absensi_siswa.php [L]
RewriteRule ^ubah_guru_mapel(?:\.smak)?$ edit_guru_mapel.php [L]
RewriteRule ^ubah_nilai_ekstrakurikuler(?:\.smak)?$ edit_grade.php [L]
RewriteRule ^ubah_nilai_mapel(?:\.smak)?$ edit_score.php [L]
RewriteRule ^ubah_siswa(?:\.smak)?$ edit_student.php [L]
RewriteRule ^ubah_mata_pelajaran(?:\.smak)?$ edit_subject.php [L]
RewriteRule ^ubah_pengguna(?:\.smak)?$ edit_user.php [L]
RewriteRule ^daftar_nilai_ekstrakurikuler(?:\.smak)?$ ekstrakurikuler_grade_list.php [L]
RewriteRule ^daftar_ekstrakurikuler(?:\.smak)?$ ekstrakurikuler_list.php [L]
RewriteRule ^cetak_rapor_massal(?:\.smak)?$ print_rapor_massal.php [L]
RewriteRule ^cetak_rapor(?:\.smak)?$ print_rapor.php [L]
RewriteRule ^daftar_siswa(?:\.smak)?$ student_list.php [L]
RewriteRule ^daftar_kategori_mapel(?:\.smak)?$ subject_category_list.php [L]
RewriteRule ^daftar_mata_pelajaran(?:\.smak)?$ subject_list.php [L]
RewriteRule ^daftar_nilai_mata_pelajaran(?:\.smak)?$ subject_score_list.php [L]
RewriteRule ^daftar_pengguna(?:\.smak)?$ user_list.php [L]
RewriteRule ^upload_absensi(?:\.smak)?$ upload_absensi_siswa.php [L]
RewriteRule ^upload_nilai_ekstrakurikuler(?:\.smak)?$ upload_grade.php [L]
RewriteRule ^upload_nilai_mapel(?:\.smak)?$ upload_score.php [L]
RewriteRule ^upload_siswa(?:\.smak)?$ upload_student.php [L]
RewriteRule ^upload_mata_pelajaran(?:\.smak)?$ upload_subject.php [L]
RewriteRule ^nilai_ekstrakurikuler(?:\.smak)?$ view_grade.php [L]
RewriteRule ^nilai_mata_pelajaran(?:\.smak)?$ view_score.php [L]
RewriteRule ^manajemen_guru_mapel(?:\.smak)?$ view_subject_teacher.php [L]
RewriteRule ^satuan_guru_mapel(?:\.smak)?$ add_subject_teacher.php [L]
RewriteRule ^upload_guru_mapel(?:\.smak)?$ upload_subject_teacher.php [L]
RewriteRule ^manajemen_wali_kelas(?:\.smak)?$ view_homeroom_teacher.php [L]
RewriteRule ^upload_wali_kelas(?:\.smak)?$ upload_homeroom_teacher.php [L]
RewriteRule ^satuan_wali_kelas(?:\.smak)?$ add_homeroom_teacher.php [L]
RewriteRule ^ubah_wali_kelas(?:\.smak)?$ edit_homeroom_teacher.php [L]
RewriteRule ^jadwal_pengisian_nilai(?:\.smak)?$ score_schedule.php [L]
RewriteRule ^kelas_perwali(?:\.smak)?$ kelas_perwali_list.php [L]
RewriteRule ^siswa_kelas_perwali(?:\.smak)?$ siswa_perkelas_list.php [L]
RewriteRule ^praktik_kerja_lapangan(?:\.smak)?$ pkl_list.php [L]
RewriteRule ^detil_pkl(?:\.smak)?$ view_pkl.php [L]
RewriteRule ^ubah_pkl(?:\.smak)?$ edit_pkl.php [L]
RewriteRule ^satuan_pkl(?:\.smak)?$ add_pkl.php [L]
RewriteRule ^upload_pkl(?:\.smak)?$ upload_pkl.php [L]




